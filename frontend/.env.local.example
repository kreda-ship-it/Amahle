# Copy this file to .env.local and fill in the real values.
#
#   cp .env.local.example .env.local
#
# .env.local is git-ignored. This template is committed so that anyone
# setting the project up knows which variables are needed.
#
# Both values come from the Supabase dashboard:
#   Project Settings -> API Keys
#
# NEXT_PUBLIC_ means Next.js sends the value to the browser. That is correct
# for both of these. The key below is designed to be public — row-level
# security in Postgres is what actually protects the data, not the key.
#
# The service_role (or "secret") key is NOT here and must never be. It
# bypasses row-level security entirely.

NEXT_PUBLIC_SUPABASE_URL=

# Accepts either the legacy "anon" key (starts with eyJ) or the newer
# "publishable" key (starts with sb_publishable_). Both work the same way.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# Which salon this deployment's public website is for — the `slug` column on
# its `organizations` row.
#
# Optional. Left blank, the site serves kedus-hair-salon, so a fresh clone
# runs without anyone having to discover this variable first.
#
# Deliberately NOT NEXT_PUBLIC_. The browser has no use for it, and a value
# that never leaves the server is one fewer thing to think about.
#
# One deployment currently serves one salon. When several share a deployment
# the slug will come from the request's hostname instead, and this variable
# retires. See src/lib/site/organization.ts.
SITE_ORG_SLUG=
